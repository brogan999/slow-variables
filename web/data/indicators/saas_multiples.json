 "sublayer_id": null,
 "timing_rationale": "Leading: valuation multiples price expected rents before any margin reports them.",
 "tracker_interpretation": "The median multiple fell to about 3x in spring 2026 on the 'AI eats software' trade and has recovered to the mid-4s; the top five trade above 30x.",
 "unit": "ratio",
 "unpublished_reason": "Cannot refresh unattended: Clouded Judgement's Substack feed refuses the nightly's cloud fetches (HTTP 403 on every run since 10 Sep 2026), so the weekly series would sit stale; the history stays on /series, and the indicator publishes again if a fetchable copy of the weekly table appears.",
 "updated_at": "2026-09-11",
 "valve_measured": null,
 "why_it_matters": "The valuation multiple is the market's expectation of durable rent at the application layer. Compression toward low single digits prices in commoditisation by AI; recovery prices in apps keeping their surplus."
