 "sublayer_id": null,
 "timing_rationale": "Lagging: output per hour rises only after firms reorganise work around a tool, and BLS prints it a quarter late and revises it.",
 "tracker_interpretation": "Productivity is growing at or a little above its usual pace, which is what an ordinary technology looks like a few years into wide use.",
 "unit": "pct",
 "unpublished_reason": null,
 "updated_at": "2026-09-10",
 "valve_measured": "adoption_to_adaptation",
 "why_it_matters": "However widely AI is used, it only matters for the economy once output per hour rises. Narayanan and Kapoor expect that to happen at the speed people and firms change, so productivity should stay near its usual trend for years even while the models race ahead."
}
