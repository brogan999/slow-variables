 "sublayer_id": null,
 "timing_rationale": "Lagging: output per hour rises only after firms reorganise work around a tool, and BLS prints it a quarter late and revises it.",
 "tracker_interpretation": "Productivity is at or slightly above trend, which is exactly what a normal-technology diffusion path looks like in year three of deployment.",
 "unit": "pct",
 "unpublished_reason": null,
 "updated_at": "2026-09-10",
 "valve_measured": "adoption_to_adaptation",
 "why_it_matters": "The adaptation stock only counts when it shows up in aggregate productivity. The paper predicts diffusion at human speed, so productivity stays near trend for years even while capability races."
