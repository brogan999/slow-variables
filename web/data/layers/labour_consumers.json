 ],
 "dependency_tier": 5,
 "description": "Workers and consumers: wages, jobs, and the value users get without paying for it. Tracked through its readings; no company list.",
 "economics": [
  {
   "binding": [
    {
     "id": "applications",
     "name": "Applications",
     "word": null
    },
    {
